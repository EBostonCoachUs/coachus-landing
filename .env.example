# Local review is the default. No submission is sent from the review UI.
VITE_RELEASE_APPROVED=false
VITE_TURNSTILE_SITE_KEY=
# Server-only values: never prefix these with VITE_. No accounts are configured in this package.
RELEASE_APPROVED=false
EARLY_ACCESS_ENABLED=false
PUBLIC_ORIGIN=https://www.coachus.com
TURNSTILE_HOSTNAME=www.coachus.com
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
FROM_ADDRESS=
# Comma-separated internal notification recipients. If omitted, the preserved
# direct Resend handler falls back to the current production notification list.
LEAD_NOTIFY_TO=matt.cady@coachus.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random 32-byte encryption key, represented by 64 hexadecimal characters.
TOKEN_ENCRYPTION_KEY=
# Separate random secret, at least 32 characters. Hashes are pseudonymous, not anonymous.
ABUSE_HASH_KEY=
CRON_SECRET=
